---
import { cdn, srcset } from '../lib/img.mjs';
interface Props { src: string; alt?: string; credit?: string; eager?: boolean; sizes?: string; max?: number; zoom?: boolean; }
const { src, alt = '', credit, eager = false, sizes = '(max-width: 760px) 100vw, 60vw', max = 1400, zoom = false } = Astro.props;
---
{zoom
  ? <a class="zoom retino" href={cdn(src, 1800)} data-didascalia={credit} aria-label="Ingrandisci la foto"><img src={cdn(src, Math.min(max, 1000))} srcset={srcset(src, max)} sizes={sizes} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" /></a>
  : <div class="retino"><img src={cdn(src, Math.min(max, 1000))} srcset={srcset(src, max)} sizes={sizes} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" /></div>}
{credit && <p class="didascalia">{credit}</p>}
