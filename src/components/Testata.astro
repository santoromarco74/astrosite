---
// Testata del tema «Inchiostro» (prova, ottobre 2026): Garamond, «La» in corsivo sopra il nome.
interface Props { piccola?: boolean; }
const { piccola = false } = Astro.props;
---
<span class:list={['testata-logo', { piccola }]}>
  <span class="logo-la">La</span>
  <span class="logo-nome">Musica del Santo</span>
  <span class="logo-motto">Guida semiseria per autostoppisti musicali</span>
</span>
