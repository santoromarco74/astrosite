---
// Riquadro articolo: foto in alto, rubrica in corsivo, titolo, sommario.
import Foto from './Foto.astro';
import { type Articolo, url, nomeCategoria, titoloBreve } from '../lib/site';
interface Props { a: Articolo; }
const { a } = Astro.props;
const cat = a.data.categories[0];
---
<article class="pezzo">
  <a class="pezzo-foto" href={url(a)} tabindex="-1" aria-hidden="true">
    {a.data.cover ? <Foto src={a.data.cover} alt="" sizes="(max-width: 700px) 100vw, 380px" max={700} /> : <div class="retino" />}
  </a>
  {cat && <a class="rubrica" href={`/${cat}/`}>{nomeCategoria(cat)}</a>}
  <h3 class="titolo"><a href={url(a)}>{titoloBreve(a)}</a></h3>
  <p>{a.data.description.length > 150 ? a.data.description.slice(0, 145).replace(/\s+\S*$/, '') + '…' : a.data.description}</p>
</article>
