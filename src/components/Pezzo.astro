---
// Articolo come locandina: blocco di colore della sezione, foto al naturale, titolo grande.
import Foto from './Foto.astro';
import { type Articolo, url, nomeCategoria, titoloBreve, dataBreve } from '../lib/site';
interface Props { a: Articolo; }
const { a } = Astro.props;
const cat = a.data.categories[0] ?? '';
---
<article class={`pezzo locandina sez-${cat}`}>
  <a class="pezzo-foto" href={url(a)} tabindex="-1" aria-hidden="true">
    {a.data.cover ? <Foto src={a.data.cover} alt="" sizes="(max-width: 700px) 100vw, 400px" max={700} /> : <div class="retino" />}
  </a>
  <div class="locandina-testo">
    <p class="locandina-meta">{cat && <a href={`/${cat}/`}>{nomeCategoria(cat)}</a>}<span>{dataBreve(a.data.date)}</span></p>
    <h3 class="titolo"><a href={url(a)}>{titoloBreve(a)}</a></h3>
  </div>
</article>
