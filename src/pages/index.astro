---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Pezzo from '../components/Pezzo.astro';
import { getArticoli, url, dataBreve, attacco, titoloBreve, nomeCategoria } from '../lib/site';

const articoli = await getArticoli();
const [primo, ...resto] = articoli;
const laterali = resto.slice(0, 4);
const altri = resto.slice(4, 10);
const archivio = resto.slice(10);
const sommario = primo.data.description.replace(/…$/, '').trim().replace(/[,;:]$/, '…');
const corto = sommario.length > 180 ? sommario.slice(0, 175).replace(/\s+\S*$/, '') + '…' : sommario;
// Se il sommario è l'inizio del testo, l'attacco riparte da dove finisce il sommario.
let testo = attacco(primo.body, 400);
const inizio = sommario.slice(0, 40);
if (inizio && testo.startsWith(inizio)) {
  const n = corto.replace(/…$/, '').split(' ').length;
  testo = testo.split(' ').slice(n).join(' ');
}
const attaccoBreve = testo.split(' ').slice(0, 45).join(' ') + '…';
const cat = primo.data.categories[0];
const titoloPrimo = titoloBreve(primo);
const lung = titoloPrimo.length > 70 ? 'lungo' : titoloPrimo.length > 40 ? 'medio' : '';
---
<Base image={primo.data.cover}>
  <section class="apertura" aria-label="In primo piano">
    <article class="apertura-primo">
      {cat && <a class="rubrica" href={`/${cat}/`}>{nomeCategoria(cat)}</a>}
      <h1 class={`titolo ${lung}`}><a href={url(primo)}>{titoloPrimo}</a></h1>
      {corto && <p class="sommario">{corto}</p>}
      <a class="foto-link" href={url(primo)} tabindex="-1" aria-hidden="true">
        {primo.data.cover && <Foto src={primo.data.cover} alt="" eager sizes="(max-width: 900px) 100vw, 640px" max={1000} />}
      </a>
    </article>
    <div class="apertura-lista">
      {laterali.map((a) => (
        <article class="riga">
          <div>
            {a.data.categories[0] && <a class="rubrica" href={`/${a.data.categories[0]}/`}>{nomeCategoria(a.data.categories[0])}</a>}
            <h2 class="titolo"><a href={url(a)}>{titoloBreve(a)}</a></h2>
            <p>{a.data.description.length > 150 ? a.data.description.slice(0, 145).replace(/\s+\S*$/, '') + '…' : a.data.description}</p>
          </div>
          <a class="riga-foto" href={url(a)} tabindex="-1" aria-hidden="true">{a.data.cover && <Foto src={a.data.cover} alt="" sizes="210px" max={400} />}</a>
        </article>
      ))}
    </div>
  </section>

  <h2 class="sezione-titolo">Altre storie</h2>
  <div class="pezzi">
    {altri.map((a) => <Pezzo a={a} />)}
  </div>

  <h2 class="sezione-titolo">Archivio</h2>
  <ul class="archivio">
    {archivio.map((a) => (
      <li><time datetime={a.data.date.toISOString()}>{dataBreve(a.data.date)}</time><a href={url(a)}>{a.data.title}</a></li>
    ))}
  </ul>
</Base>
