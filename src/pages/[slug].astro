---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Pezzo from '../components/Pezzo.astro';
import categorie from '../data/categorie.json';
import { getArticoli, SITE, dataBreve, dataLunga, nomeCategoria, nomeTag, minutiLettura, type Articolo } from '../lib/site';

export async function getStaticPaths() {
  const articoli = await getArticoli();
  const pagine = await getCollection('pagine');
  const catSlugs = Object.keys(categorie).filter((c) => articoli.some((a) => a.data.categories.includes(c)));
  return [
    ...articoli.map((a) => ({ params: { slug: a.id }, props: { kind: 'articolo', entry: a, tutti: articoli } })),
    ...pagine.map((p) => ({ params: { slug: p.id }, props: { kind: 'pagina', entry: p } })),
    ...catSlugs.map((c) => ({ params: { slug: c }, props: { kind: 'categoria', cat: c, lista: articoli.filter((a) => a.data.categories.includes(c)) } })),
  ];
}

const props = Astro.props as any;
const kind: 'articolo' | 'pagina' | 'categoria' = props.kind;
let Content: any = null;
if (kind !== 'categoria') ({ Content } = await render(props.entry));

let correlati: Articolo[] = [];
if (kind === 'articolo') {
  const a = props.entry as Articolo;
  correlati = (props.tutti as Articolo[])
    .filter((x) => x.id !== a.id)
    .map((x) => ({ x, score: x.data.tags.filter((t) => a.data.tags.includes(t)).length * 2 + (x.data.categories.some((c) => a.data.categories.includes(c)) ? 1 : 0) }))
    .sort((p, q) => q.score - p.score || q.x.data.date.valueOf() - p.x.data.date.valueOf())
    .slice(0, 3).map((p) => p.x);
}
const catDesc = kind === 'categoria' ? (categorie as any)[props.cat]?.description : '';
---
{kind === 'articolo' && (() => {
  const a = props.entry as Articolo; const d = a.data; const cat = d.categories[0];
  const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description,
    datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
    author: { '@type': 'Person', name: SITE.author }, image: d.cover ? new URL(d.cover, SITE.url).href : undefined,
    mainEntityOfPage: new URL(`/${a.id}/`, SITE.url).href, inLanguage: 'it-IT' };
  return (
  <Base title={d.title} description={d.description} image={d.cover} type="article">
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
    <article>
      <header class="articolo-testa">
        {cat && <a class="rubrica" href={`/${cat}/`}>{nomeCategoria(cat)}</a>}
        <h1 class={`titolone ${d.title.length > 70 ? 'lungo' : d.title.length > 40 ? 'medio' : ''}`}>{d.title}</h1>
        {d.description && <p class="occhiello">{d.description}</p>}
        <p class="meta">di {SITE.author} · <time datetime={d.date.toISOString()}>{dataLunga(d.date)}</time> · {minutiLettura(a.body)} min di lettura</p>
      </header>
      {d.cover && <div class="articolo-copertina"><Foto src={d.cover} alt={d.coverAlt ?? ''} credit={d.coverCredit} eager /></div>}
      <div class="corpo"><Content /></div>
      {d.tags.length > 0 && <ul class="tag-lista" aria-label="Tag">{d.tags.map((t) => <li><a href={`/tag/${t}/`}>{nomeTag(t)}</a></li>)}</ul>}
      <p class="firma">— {SITE.author}</p>
    </article>
    {correlati.length > 0 && <>
      <div class="barra-sezione"><h2>All'interno</h2><p>Potrebbero piacerti anche</p></div>
      <div class="colonne">{correlati.map((x) => <Pezzo a={x} />)}</div>
    </>}
  </Base>);
})()}

{kind === 'pagina' && (
  <Base title={props.entry.data.title}>
    <header class="articolo-testa"><h1 class="titolone">{props.entry.data.title}</h1></header>
    <div class="corpo"><Content /></div>
  </Base>
)}

{kind === 'categoria' && (
  <Base title={nomeCategoria(props.cat)} description={catDesc || `Tutti gli articoli della sezione ${nomeCategoria(props.cat)}`}>
    <header class="articolo-testa">
      <span class="rubrica">Sezione</span>
      <h1 class="titolone">{nomeCategoria(props.cat)}</h1>
      {catDesc && <p class="occhiello">{catDesc}</p>}
      <p class="meta">{props.lista.length} articoli</p>
    </header>
    <div class="colonne">{props.lista.map((x: Articolo) => <Pezzo a={x} />)}</div>
  </Base>
)}
