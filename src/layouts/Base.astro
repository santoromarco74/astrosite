---
import '../styles/global.css';
import { SITE, SEZIONI, nomeCategoria, getArticoli } from '../lib/site';

// sezione: la voce di menu da evidenziare anche fuori dalla sua pagina (es. la sezione di un articolo)
interface Props { title?: string; description?: string; image?: string; type?: string; sezione?: string; }
const { title, description = SITE.tagline, image, type = 'website', sezione } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
const tuttiArticoli = await getArticoli();
// nel menu solo le sezioni che hanno almeno un articolo pubblicato (es. «Imperdibili» compare con il primo disco)
const sezioniAttive = SEZIONI.filter((s) => tuttiArticoli.some((a) => a.data.categories.includes(s)));
const voci = [{ href: '/', label: 'Home' }, ...sezioniAttive.map((s) => ({ href: `/${s}/`, label: nomeCategoria(s) })), { href: '/chi-sono/', label: 'Chi sono' }];
const corrente = (href: string) => (path === href ? 'page' : sezione && href === `/${sezione}/` ? 'true' : undefined);
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <meta name="theme-color" content="#F5F2EC" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=Archivo:wdth,wght@87,700;87,800&display=swap" />
  <slot name="head" />
</head>
<body>
  <a class="salta" href="#contenuto">Vai al contenuto</a>
  <header class="testa">
    <div class="wrap">
      <a class="logo" href="/" aria-label={`${SITE.name} — prima pagina`}>
        <span class="logo-nome">{SITE.name}</span>
        <span class="logo-motto">Biglietteria aperta · {SITE.tagline.toLowerCase()}</span>
      </a>
      <nav class="menu" aria-label="Sezioni">
        <ul>
          {voci.map((v) => <li><a href={v.href} aria-current={corrente(v.href)}>{v.label}</a></li>)}
          <li><a class="cerca-icona" href="/cerca/" aria-label="Cerca nel sito" aria-current={corrente('/cerca/')}>
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="contenuto" class="wrap">
    <slot />
  </main>
  <footer class="piede">
    <div class="wrap">
      <div class="piede-marchio">
        <a class="logo" href="/" aria-label={SITE.name}><span class="logo-nome">{SITE.name}</span></a>
        <p>Conservate il biglietto: vale per tutti i concerti della vita.</p>
      </div>
      <span class="barre" aria-hidden="true"></span>
      <ul class="piede-link">
        {sezioniAttive.map((s) => <li><a href={`/${s}/`}>{nomeCategoria(s)}</a></li>)}
        <li><a href="/chi-sono/">Chi sono</a></li>
        <li><a href="/cerca/">Cerca</a></li>
        <li><a href="/rss.xml">Feed RSS</a></li>
        <li><a href="/privacy-policy/">Privacy</a></li>
      </ul>
      <small>© {new Date().getFullYear()} {SITE.author} · {SITE.motto}</small>
    </div>
  </footer>
</body>
</html>
