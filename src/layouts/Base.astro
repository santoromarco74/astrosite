---
import '../styles/global.css';
import Testata from '../components/Testata.astro';
import { SITE, SEZIONI, nomeCategoria, dataBreve, getArticoli } from '../lib/site';

interface Props { title?: string; description?: string; image?: string; type?: string; }
const { title, description = SITE.tagline, image, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
const tuttiArticoli = await getArticoli();
const numero = tuttiArticoli.length;
// nel menu solo le sezioni che hanno almeno un articolo pubblicato (es. «Imperdibili» compare con il primo disco)
const sezioniAttive = SEZIONI.filter((s) => tuttiArticoli.some((a) => a.data.categories.includes(s)));
const voci = [{ href: '/', label: 'Home' }, ...sezioniAttive.map((s) => ({ href: `/${s}/`, label: nomeCategoria(s) })), { href: '/chi-sono/', label: 'Chi sono' }];
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <meta name="theme-color" content="#141414" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400;1,8..60,600&display=swap" />
  <slot name="head" />
</head>
<body>
  <a class="salta" href="#contenuto">Vai al contenuto</a>
  <header class="testa">
    <div class="wrap riga-testata">
      <details class="menu-mobile solo-mobile">
        <summary aria-label="Apri il menu">
          <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </summary>
        <nav aria-label="Sezioni (mobile)">
          <ul>{voci.map((v) => <li><a href={v.href} aria-current={path === v.href ? 'page' : undefined}>{v.label}</a></li>)}</ul>
        </nav>
      </details>
      <p class="meta-edizione solo-desktop">N. {numero}<br /><span id="oggi">{dataBreve(new Date())}</span></p>
      <a class="logo" href="/" aria-label={`${SITE.name} — prima pagina`}><Testata /></a>
      <div class="lato-dx">
        <p class="prezzo solo-desktop">Prezzo: un ascolto</p>
        <a class="cerca-icona" href="/cerca/" aria-label="Cerca nel sito">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </a>
      </div>
    </div>
    <nav class="menu solo-desktop" aria-label="Sezioni">
      <ul class="wrap">{voci.map((v) => <li><a href={v.href} aria-current={path === v.href ? 'page' : undefined}>{v.label}</a></li>)}</ul>
    </nav>
  </header>
  <main id="contenuto" class="wrap">
    <slot />
  </main>
  <footer class="piede">
    <div class="wrap">
      <div class="piede-marchio">
        <a class="logo" href="/" aria-label={SITE.name}><Testata /></a>
        <p class="sottotitolo-testata">{SITE.tagline}</p>
      </div>
      <ul class="piede-link">
        {sezioniAttive.map((s) => <li><a href={`/${s}/`}>{nomeCategoria(s)}</a></li>)}
        <li><a href="/chi-sono/">Chi sono</a></li>
        <li><a href="/cerca/">Cerca</a></li>
        <li><a href="/rss.xml">Feed RSS</a></li>
        <li><a href="/privacy-policy/">Privacy</a></li>
      </ul>
      <small>© {new Date().getFullYear()} {SITE.author}</small>
    </div>
  </footer>
  <script is:inline>
    (function(){try{var g=['Domenica','Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato'],m=['gennaio','febbraio','marzo','aprile','maggio','giugno','luglio','agosto','settembre','ottobre','novembre','dicembre'],d=new Date(),e=document.getElementById('oggi');if(e)e.textContent=d.getDate()+' '+m[d.getMonth()]+' '+d.getFullYear();}catch(_){}})();
  </script>
</body>
</html>
