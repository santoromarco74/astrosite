ntent":{"rendered":"<span class=\"span-reading-time rt-reading-time\" style=\"display: block;\"><span class=\"rt-label rt-prefix\">Tempo di lettura:<\/span> <span class=\"rt-time\"> &lt; 1<\/span> <span class=\"rt-label rt-postfix\">minuti<\/span><\/span>\n<div class=\"wp-block-columns are-vertically-aligned-top is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-top is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:33.34%\">\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-versione-short\">Versione short<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Marco Santoro, 46 anni, da sempre appassionato di musica e tecnologia, costantemente alla ricerca di nuovi stimoli e spazi di condivisione.<\/p>\n\n\n<\/div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-top is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:33.34%\">\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"h-versione-long\">Versione long<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\" id=\"block-ec509dc9-3f87-4109-82a7-00db46d39da7\">Mi chiamo Marco Santoro, 46 anni , ligure di adozione ma di origine laziale, sono sempre alla ricerca di nuovi stimoli, cerco di condividere le mie passioni pi\u00f9 forti come la musica e i viaggi con chiunque voglia farne parte.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Sognatore per passione, realista per professione, sono una persona estremamente curiosa e per questo cerco sempre nuove attivit\u00e0 che stimolino la mia creativit\u00e0.<\/p>\n\n\n<\/div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-top is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:33.33%\">\n<figure class=\"wp-block-image size-large is-resized\"><img decoding=\"async\" src=\"https:\/\/lamusicadelsanto.it\/wp-content\/uploads\/2021\/01\/2019-05-20-13h51m29-768x1024.jpg\" alt=\"\" class=\"wp-image-993\" width=\"258\" height=\"344\" title=\"\"><figcaption>            Epson Show a Tokyo<\/figcaption><\/figure>\n<\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\">Una citazione di Rino Gaetano aiuter\u00e0 meglio a capire lo spirito di questa nuova avventura:<\/p>\n\n\n\n<blockquote class=\"wp-block-quote has-text-align-left is-layout-flow wp-block-quote-is-layout-flow\"><p>\u201cIo scriver\u00f2 se vuoi perch\u00e9 cerco un mondo diverso <\/p><p>con stelle al neon e un poco d&#8217;universo <\/p><p>mi sento un eroe a tempo perso \u2026<\/p><p>Io scriver\u00f2 perch\u00e9 ho vissuto anche di espedienti <\/p><p>perch\u00e9 a volte ho mostrato anche i denti <\/p><p>perch\u00e9 non potevo vivere altrimenti <\/p><p>io scriver\u00f2 sul mondo e sulle sue brutture <\/p><p>sulla mia immagine pubblica e sulle camere oscure <\/p><p>sul mio passato e sulle mie paure\u201d<\/p><p><\/p><cite>da &#8220;Io scriver\u00f2&#8221; di Rino Gaetano<\/cite><\/blockquote>\n","protected":false},"excerpt":{"rendered":"<p><span class=\"span-reading-time rt-reading-time\" style=\"display: block;\"><span class=\"rt-label rt-prefix\">Tempo di lettura:<\/span> <span class=\"rt-time\"> &lt; 1<\/span> <span class=\"rt-label rt-postfix\">minuti<\/span><\/span>Versione short Marco Santoro, 46 anni, da sempre appassionato di musica e tecnologia, costantemente alla ricerca di nuovi stimoli e spazi di condivisione. Versione long&#8230;<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_coblocks_attr":"","_coblocks_dimensions":"","_coblocks_responsive_height":"","_coblocks_accordion_ie_support":"","rop_custom_images_group":[],"rop_custom_messages_group":[],"rop_publish_now":"initial","rop_publish_now_accounts":[],"rop_publish_now_history":[],"rop_publish_now_status":"pending","footnotes":""},"class_list":["post-25","page","type-page","status-publish","hentry","entry","double"],"jetpack_shortlink":"https:\/\/wp.me\/PcOJEv-p","_links":{"self":[{"href":"https:\/\/lamusicadelsanto.it\/wp-json\/wp\/v2\/pages\/25","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lamusicadelsanto.it\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/lamusicadelsanto.it\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/lamusicadelsanto.it\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/lamusicadelsanto.it\/wp-json\/wp\/v2\/comments?post=25"}],"version-history":[{"count":0,"href":"https:\/\/lamusicadelsanto.it\/wp-json\/wp\/v2\/pages\/25\/revisions"}],"wp:attachment":[{"href":"https:\/\/lamusicadelsanto.it\/wp-json\/wp\/v2\/media?parent=25"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}]